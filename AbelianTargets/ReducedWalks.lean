import Mathlib.Combinatorics.SimpleGraph.Walk.Maps
import Mathlib.Algebra.Ring.Parity
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.OrderOfElement
import Lean.Elab.Tactic.Omega

/-!
# Reduced graph-walk homotopy and parity

This file formalizes the walk presentation in §2.2 of arXiv:2609.39824.
`ReducedHomotopic` is the smallest equivalence compatible with concatenation
which deletes spurs and closed walks of length four. Its restriction to closed
walks is the reduced homotopy relation used by the paper.

The statements `HasOddInvolution` and `HasOddTorsion` express the hypotheses
of Theorem 1.4 and Proposition 7.1 directly in this walk presentation.
The geometric construction of continuous graph homomorphisms is separate.
-/

namespace AbelianTargets

universe u
variable {V : Type u} (H : SimpleGraph V)

/-- Walk equivalence generated by spur cancellation, four-walk cancellation,
and compatibility with concatenation. -/
inductive ReducedHomotopic : {a b : V} → H.Walk a b → H.Walk a b → Prop
  | refl {a b} (p : H.Walk a b) : ReducedHomotopic p p
  | symm {a b} {p q : H.Walk a b} :
      ReducedHomotopic p q → ReducedHomotopic q p
  | trans {a b} {p q r : H.Walk a b} :
      ReducedHomotopic p q → ReducedHomotopic q r → ReducedHomotopic p r
  | append {a b c} {p q : H.Walk a b} {r s : H.Walk b c} :
      ReducedHomotopic p q → ReducedHomotopic r s →
      ReducedHomotopic (p.append r) (q.append s)
  | spur {a b} (h : H.Adj a b) :
      ReducedHomotopic (.cons h (.cons h.symm .nil)) .nil
  | four {a} (p : H.Walk a a) (hp : p.length = 4) :
      ReducedHomotopic p .nil

namespace ReducedHomotopic

variable {H}

/-- Every generating relation preserves the parity of the walk length. -/
theorem length_mod_two {a b : V} {p q : H.Walk a b}
    (h : ReducedHomotopic H p q) : p.length % 2 = q.length % 2 := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | append _ _ ih₁ ih₂ =>
      simp only [SimpleGraph.Walk.length_append]
      omega
  | spur => simp
  | four p hp => simp [hp]

/-- Parity can therefore be read from either representative. -/
theorem odd_length_iff {a b : V} {p q : H.Walk a b}
    (h : ReducedHomotopic H p q) : Odd p.length ↔ Odd q.length := by
  rw [Nat.odd_iff, Nat.odd_iff, h.length_mod_two]

/-- A walk followed by its reversal cancels by spur moves alone. -/
theorem append_reverse {a b : V} (p : H.Walk a b) :
    ReducedHomotopic H (p.append p.reverse) .nil := by
  induction p with
  | nil => exact .refl _
  | @cons a b c h p ih =>
      have hc := ReducedHomotopic.append (ReducedHomotopic.refl h.toWalk)
        (ReducedHomotopic.append ih (ReducedHomotopic.refl h.symm.toWalk))
      simp only [SimpleGraph.Walk.nil_append,
        SimpleGraph.Walk.cons_nil_append, SimpleGraph.Walk.append_assoc,
        SimpleGraph.Walk.reverse_cons] at hc ⊢
      exact hc.trans (.spur h)

/-- Reversing a walk and then following it also cancels. -/
theorem reverse_append {a b : V} (p : H.Walk a b) :
    ReducedHomotopic H (p.reverse.append p) .nil := by
  simpa only [SimpleGraph.Walk.reverse_reverse] using append_reverse p.reverse

/-- Graph homomorphisms preserve every generating reduced homotopy move. -/
theorem map {W : Type*} {J : SimpleGraph W} (f : H →g J)
    {a b : V} {p q : H.Walk a b} (h : ReducedHomotopic H p q) :
    ReducedHomotopic J (p.map f) (q.map f) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | append _ _ ih₁ ih₂ =>
      simpa only [SimpleGraph.Walk.map_append] using ReducedHomotopic.append ih₁ ih₂
  | spur h => exact .spur (f.map_adj h)
  | four p hp => exact .four (p.map f) (by simpa using hp)

/-- Reversal preserves the reduced homotopy relation. -/
theorem reverse {a b : V} {p q : H.Walk a b}
    (h : ReducedHomotopic H p q) : ReducedHomotopic H p.reverse q.reverse := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | append _ _ ih₁ ih₂ =>
      simpa only [SimpleGraph.Walk.reverse_append] using ReducedHomotopic.append ih₂ ih₁
  | spur h => simpa using ReducedHomotopic.spur h
  | four p hp => exact .four p.reverse (by simpa using hp)

/-- The paper's local replacement of a two-edge segment is a reduced
homotopy move, including replacements with repeated vertices. -/
theorem two_step {a b : V} (p q : H.Walk a b)
    (hp : p.length = 2) (hq : q.length = 2) : ReducedHomotopic H p q := by
  have hsquare : ReducedHomotopic H (p.append q.reverse) .nil :=
    .four _ (by simp [hp, hq])
  have hfill := ReducedHomotopic.append hsquare (ReducedHomotopic.refl q)
  have hcancel := ReducedHomotopic.append (ReducedHomotopic.refl p) (reverse_append q)
  simp only [SimpleGraph.Walk.nil_append] at hfill
  simp only [SimpleGraph.Walk.append_assoc, SimpleGraph.Walk.append_nil] at hcancel
  exact hcancel.symm.trans hfill

end ReducedHomotopic

/-- The concatenation of `n` copies of a based closed walk. -/
def loopPower {b : V} (γ : H.Walk b b) : ℕ → H.Walk b b
  | 0 => .nil
  | n + 1 => γ.append (loopPower γ n)

variable {H}

@[simp] theorem loopPower_zero {b : V} (γ : H.Walk b b) :
    loopPower H γ 0 = .nil := rfl

@[simp] theorem loopPower_succ {b : V} (γ : H.Walk b b) (n : ℕ) :
    loopPower H γ (n + 1) = γ.append (loopPower H γ n) := rfl

@[simp] theorem loopPower_one {b : V} (γ : H.Walk b b) :
    loopPower H γ 1 = γ := by simp

/-- The length of the concatenation power has the expected exact value. -/
@[simp] theorem loopPower_length {b : V} (γ : H.Walk b b) (n : ℕ) :
    (loopPower H γ n).length = n * γ.length := by
  induction n with
  | zero => simp
  | succ n ih => simp [ih, Nat.add_mul, Nat.add_comm]

/-- Powers respect reduced homotopy. -/
theorem loopPower_congr {b : V} {γ δ : H.Walk b b}
    (h : ReducedHomotopic H γ δ) (n : ℕ) :
    ReducedHomotopic H (loopPower H γ n) (loopPower H δ n) := by
  induction n with
  | zero => exact .refl _
  | succ n ih => exact .append h ih

/-- Addition of exponents is concatenation of powers. -/
theorem loopPower_add {b : V} (γ : H.Walk b b) (m n : ℕ) :
    loopPower H γ (m + n) = (loopPower H γ m).append (loopPower H γ n) := by
  induction m with
  | zero => simp
  | succ m ih => simp [Nat.succ_add, ih, SimpleGraph.Walk.append_assoc]

/-- Applying a graph homomorphism commutes with concatenation powers. -/
@[simp] theorem loopPower_map {W : Type*} {J : SimpleGraph W} (f : H →g J)
    {b : V} (γ : H.Walk b b) (n : ℕ) :
    (loopPower H γ n).map f = loopPower J (γ.map f) n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [loopPower_succ, SimpleGraph.Walk.map_append, ih]

/-- An odd walk never represents the trivial reduced class. -/
theorem odd_not_reduced_null {b : V} {γ : H.Walk b b}
    (hodd : Odd γ.length) : ¬ ReducedHomotopic H γ .nil := by
  intro h
  have hpar := h.length_mod_two
  simp only [SimpleGraph.Walk.length_nil, Nat.zero_mod] at hpar
  rw [Nat.odd_iff] at hodd
  omega

/-- Any trivial concatenation power of an odd walk has even exponent.
The positivity hypothesis is unnecessary for this parity implication. -/
theorem even_exponent_of_odd_null_power {b : V} {γ : H.Walk b b} {N : ℕ}
    (hodd : Odd γ.length)
    (hnull : ReducedHomotopic H (loopPower H γ N) .nil) : Even N := by
  have hpar := hnull.length_mod_two
  simp only [loopPower_length, SimpleGraph.Walk.length_nil, Nat.zero_mod] at hpar
  rw [Nat.odd_iff] at hodd
  rw [Nat.mul_mod, hodd] at hpar
  simp only [Nat.mul_one, Nat.mod_mod] at hpar
  exact Nat.even_iff.mpr hpar

/-- The order-two hypothesis in Theorem 1.4, in the paper's walk presentation. -/
def HasOddInvolution (H : SimpleGraph V) : Prop :=
  ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
    ReducedHomotopic H (loopPower H γ 2) .nil

/-- The finite-order hypothesis in Proposition 7.1, in the same presentation. -/
def HasOddTorsion (H : SimpleGraph V) : Prop :=
  ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
    ∃ N : ℕ, 0 < N ∧ ReducedHomotopic H (loopPower H γ N) .nil

/-- Theorem 1.4's hypothesis is a special case of Proposition 7.1's. -/
theorem HasOddInvolution.hasOddTorsion (h : HasOddInvolution H) : HasOddTorsion H := by
  obtain ⟨b, γ, hodd, hnull⟩ := h
  exact ⟨b, γ, hodd, 2, by decide, hnull⟩

/-- Odd involutions pass to graph-homomorphic target graphs. -/
theorem HasOddInvolution.map {W : Type*} {J : SimpleGraph W} (f : H →g J)
    (h : HasOddInvolution H) : HasOddInvolution J := by
  obtain ⟨b, γ, hodd, hnull⟩ := h
  exact ⟨f b, γ.map f, by simpa using hodd,
    by simpa only [loopPower_map, SimpleGraph.Walk.map_nil] using hnull.map f⟩

/-- Odd finite-order classes also pass to graph-homomorphic target graphs. -/
theorem HasOddTorsion.map {W : Type*} {J : SimpleGraph W} (f : H →g J)
    (h : HasOddTorsion H) : HasOddTorsion J := by
  obtain ⟨b, γ, hodd, N, hpos, hnull⟩ := h
  exact ⟨f b, γ.map f, by simpa using hodd, N, hpos, by simpa using hnull.map f⟩

/-- The finite exponent in Proposition 7.1 can always be chosen positive and even. -/
theorem HasOddTorsion.exists_even_exponent (h : HasOddTorsion H) :
    ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
      ∃ N : ℕ, 0 < N ∧ Even N ∧ ReducedHomotopic H (loopPower H γ N) .nil := by
  obtain ⟨b, γ, hodd, N, hpos, hnull⟩ := h
  exact ⟨b, γ, hodd, N, hpos, even_exponent_of_odd_null_power hodd hnull, hnull⟩

/-- For a trivial power `N`, the Baumslag–Solitar exponent `N+1` reduces to
one copy of the original loop. This is the relation used by Proposition 7.1. -/
theorem null_power_succ_reduced {b : V} {γ : H.Walk b b} {N : ℕ}
    (hnull : ReducedHomotopic H (loopPower H γ N) .nil) :
    ReducedHomotopic H (loopPower H γ (N + 1)) γ := by
  simpa using ReducedHomotopic.append (ReducedHomotopic.refl γ) hnull

/-- The replacement auxiliary exponent is odd and at least three. -/
theorem auxiliary_exponent_properties {b : V} {γ : H.Walk b b} {N : ℕ}
    (hodd : Odd γ.length) (hpos : 0 < N)
    (hnull : ReducedHomotopic H (loopPower H γ N) .nil) :
    Odd (N + 1) ∧ 3 ≤ N + 1 := by
  have heven := even_exponent_of_odd_null_power hodd hnull
  constructor
  · exact heven.add_odd (by decide : Odd (1 : ℕ))
  · have hmod := Nat.even_iff.mp heven
    omega

/-- The reduced homotopy relation on closed walks at a fixed basepoint. -/
def reducedWalkSetoid (H : SimpleGraph V) (b : V) : Setoid (H.Walk b b) where
  r := ReducedHomotopic H
  iseqv := ⟨ReducedHomotopic.refl, ReducedHomotopic.symm, ReducedHomotopic.trans⟩

/-- The group `Π₁*(H,b)`: based closed walks modulo spur and four-walk relations. -/
def ReducedFundamentalGroup (H : SimpleGraph V) (b : V) :=
  Quotient (reducedWalkSetoid H b)

namespace ReducedFundamentalGroup

variable (H) (b : V)

/-- The class represented by a based closed walk. -/
def ofWalk (γ : H.Walk b b) : ReducedFundamentalGroup H b :=
  Quotient.mk (reducedWalkSetoid H b) γ

instance : Group (ReducedFundamentalGroup H b) where
  one := ofWalk H b .nil
  mul := Quotient.map₂ SimpleGraph.Walk.append
    (fun _ _ h₁ _ _ h₂ => ReducedHomotopic.append h₁ h₂)
  inv := Quotient.map SimpleGraph.Walk.reverse
    (fun _ _ h => ReducedHomotopic.reverse h)
  mul_assoc := by
    intro x y z
    refine Quotient.inductionOn₃ x y z ?_
    intro p q r
    change ofWalk H b ((p.append q).append r) = ofWalk H b (p.append (q.append r))
    exact congrArg (ofWalk H b) (SimpleGraph.Walk.append_assoc p q r).symm
  one_mul := by
    intro x
    refine Quotient.inductionOn x ?_
    intro p
    rfl
  mul_one := by
    intro x
    refine Quotient.inductionOn x ?_
    intro p
    change ofWalk H b (p.append .nil) = ofWalk H b p
    rw [SimpleGraph.Walk.append_nil]
  inv_mul_cancel := by
    intro x
    refine Quotient.inductionOn x ?_
    intro p
    exact Quotient.sound (ReducedHomotopic.reverse_append p)

variable {H b}

@[simp] theorem ofWalk_nil : ofWalk H b .nil = 1 := rfl

@[simp] theorem ofWalk_append (γ δ : H.Walk b b) :
    ofWalk H b (γ.append δ) = ofWalk H b γ * ofWalk H b δ := rfl

@[simp] theorem ofWalk_reverse (γ : H.Walk b b) :
    ofWalk H b γ.reverse = (ofWalk H b γ)⁻¹ := rfl

/-- Equality of reduced classes is exactly the generated walk equivalence. -/
theorem ofWalk_eq_iff (γ δ : H.Walk b b) :
    ofWalk H b γ = ofWalk H b δ ↔ ReducedHomotopic H γ δ := Quotient.eq

/-- The paper's equality with the identity, expressed in the quotient group. -/
theorem ofWalk_eq_one_iff (γ : H.Walk b b) :
    ofWalk H b γ = 1 ↔ ReducedHomotopic H γ .nil := ofWalk_eq_iff γ .nil

@[simp] theorem ofWalk_loopPower (γ : H.Walk b b) (n : ℕ) :
    ofWalk H b (loopPower H γ n) = (ofWalk H b γ) ^ n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [loopPower_succ, ofWalk_append, ih, pow_succ']

/-- Length parity is a group homomorphism from the reduced fundamental group
to `ℤ/2ℤ`, written multiplicatively to match the source group. -/
def parity : ReducedFundamentalGroup H b →* Multiplicative (ZMod 2) where
  toFun := Quotient.lift (fun γ : H.Walk b b => Multiplicative.ofAdd (γ.length : ZMod 2))
    (fun γ δ h => congrArg Multiplicative.ofAdd
      ((ZMod.natCast_eq_natCast_iff' γ.length δ.length 2).mpr h.length_mod_two))
  map_one' := rfl
  map_mul' := by
    intro x y
    refine Quotient.inductionOn₂ x y ?_
    intro γ δ
    change Multiplicative.ofAdd ((γ.append δ).length : ZMod 2) =
      Multiplicative.ofAdd (γ.length : ZMod 2) * Multiplicative.ofAdd (δ.length : ZMod 2)
    rw [SimpleGraph.Walk.length_append, Nat.cast_add]
    rfl

@[simp] theorem parity_ofWalk (γ : H.Walk b b) :
    parity (ofWalk H b γ) = Multiplicative.ofAdd (γ.length : ZMod 2) := rfl

/-- A graph homomorphism induces a homomorphism of the reduced groups. -/
def map {W : Type*} {J : SimpleGraph W} (f : H →g J) :
    ReducedFundamentalGroup H b →* ReducedFundamentalGroup J (f b) where
  toFun := Quotient.map (SimpleGraph.Walk.map f) (fun _ _ h => h.map f)
  map_one' := rfl
  map_mul' := by
    intro x y
    refine Quotient.inductionOn₂ x y ?_
    intro γ δ
    change ofWalk J (f b) ((γ.append δ).map f) =
      ofWalk J (f b) ((γ.map f).append (δ.map f))
    rw [SimpleGraph.Walk.map_append]

@[simp] theorem map_ofWalk {W : Type*} {J : SimpleGraph W} (f : H →g J)
    (γ : H.Walk b b) : map f (ofWalk H b γ) = ofWalk J (f b) (γ.map f) := rfl

/-- Graph homomorphisms preserve the parity homomorphism. -/
theorem parity_map {W : Type*} {J : SimpleGraph W} (f : H →g J)
    (x : ReducedFundamentalGroup H b) : parity (map f x) = parity x := by
  refine Quotient.inductionOn x ?_
  intro γ
  change Multiplicative.ofAdd ((γ.map f).length : ZMod 2) =
    Multiplicative.ofAdd (γ.length : ZMod 2)
  rw [SimpleGraph.Walk.length_map]

end ReducedFundamentalGroup

/-- The walk presentation of the involution hypothesis is exactly the
group-theoretic statement `[γ]² = 1`. -/
theorem hasOddInvolution_iff (H : SimpleGraph V) : HasOddInvolution H ↔
    ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
      (ReducedFundamentalGroup.ofWalk H b γ) ^ 2 = 1 := by
  simp only [HasOddInvolution, ← ReducedFundamentalGroup.ofWalk_loopPower,
    ReducedFundamentalGroup.ofWalk_eq_one_iff]

/-- The finite-order hypothesis is exactly the existence of a positive
trivial power in the actual reduced fundamental group. -/
theorem hasOddTorsion_iff (H : SimpleGraph V) : HasOddTorsion H ↔
    ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
      ∃ N : ℕ, 0 < N ∧ (ReducedFundamentalGroup.ofWalk H b γ) ^ N = 1 := by
  simp only [HasOddTorsion, ← ReducedFundamentalGroup.ofWalk_loopPower,
    ReducedFundamentalGroup.ofWalk_eq_one_iff]

/-- In mathlib's terminology, the class required by Proposition 7.1 is
precisely an odd class of finite order. -/
theorem hasOddTorsion_iff_isOfFinOrder (H : SimpleGraph V) : HasOddTorsion H ↔
    ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
      IsOfFinOrder (ReducedFundamentalGroup.ofWalk H b γ) := by
  simp only [hasOddTorsion_iff, isOfFinOrder_iff_pow_eq_one]

/-- The order itself, rather than merely a trivializing exponent, is even. -/
theorem odd_class_order_even {b : V} {γ : H.Walk b b} (hodd : Odd γ.length) :
    Even (orderOf (ReducedFundamentalGroup.ofWalk H b γ)) := by
  apply even_exponent_of_odd_null_power hodd
  apply (ReducedFundamentalGroup.ofWalk_eq_one_iff _).mp
  rw [ReducedFundamentalGroup.ofWalk_loopPower]
  exact pow_orderOf_eq_one (ReducedFundamentalGroup.ofWalk H b γ)

end AbelianTargets
